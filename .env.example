# Azure OpenAI / Foundry (auth via `az login` or managed identity — no API keys)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=chat-model
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding-model
# Set after deploying the fine-tuned model (finetune.submit prints its name)
# AZURE_OPENAI_FINETUNED_DEPLOYMENT=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_INDEX=policies

# Token prices (USD per 1M tokens) for the classifier cost comparison — from your Azure price sheet
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0

# Azure Bot (Microsoft 365 Agents SDK) — from the Azure Bot resource / Entra app registration
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=

# MLflow (defaults to a local SQLite file)
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
